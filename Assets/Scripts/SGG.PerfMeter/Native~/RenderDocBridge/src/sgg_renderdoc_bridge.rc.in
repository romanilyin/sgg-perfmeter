#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @SGG_RD_FILE_VERSION@
 PRODUCTVERSION @SGG_RD_FILE_VERSION@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
